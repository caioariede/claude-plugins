{
  "version": 1,
  "gates": [
    {
      "id": "unit.plan-pause",
      "kind": "action",
      "trigger": { "phase": "plan-pause", "kind": "unit" },
      "context_slots": ["plan_path", "task_titles"],
      "prompt": "Plan saved. Confirm to derive tasks and continue.",
      "action": "await_plan_confirm",
      "stop": true
    },
    {
      "id": "unit.ship-pause",
      "kind": "picker",
      "trigger": { "phase": "ship-pause", "kind": "unit" },
      "prompt": "How do you want to proceed?",
      "default_option": 1,
      "options": [
        { "n": 1, "label": "Not now (default)" },
        { "n": 2, "label": "Ship — open PR and run review checks" },
        { "n": 3, "label": "ws-next — recommend next action across workstream" }
      ]
    },
    {
      "id": "unit.draft-pr",
      "kind": "picker",
      "trigger": { "phase": "draft-pr", "kind": "unit" },
      "prompt": "How do you want to proceed?",
      "default_option": 1,
      "options": [
        { "n": 1, "label": "Not now (default)" },
        { "n": 2, "label": "Mark ready — promote draft to ready for review" },
        { "n": 3, "label": "ws-next — recommend next action across workstream" }
      ]
    },
    {
      "id": "unit.ship-detect",
      "kind": "picker",
      "trigger": { "overlay": "ship-detect", "kind": "unit" },
      "prompt": "Work may already be on the default branch (ledger tip is behind default).",
      "default_option": 1,
      "options": [
        { "n": 1, "label": "Not now (default)" },
        { "n": 2, "label": "Record merged-via and reconcile tasks" },
        { "n": 3, "label": "Continue resume — not shipped yet" }
      ]
    },
    {
      "id": "unit.blocked-override",
      "kind": "guard",
      "trigger": { "phase": "blocked", "kind": "unit" },
      "prompt": "Unit has unmet dependencies. Proceeding will override blocker checks.",
      "options": [
        { "n": 1, "label": "Stop (default)" },
        { "n": 2, "label": "Override and resume anyway" }
      ]
    },
    {
      "id": "unit.prewalk-config",
      "kind": "action",
      "trigger": { "phase": "prewalk-config", "kind": "unit" },
      "action": "print_required_config",
      "stop": true
    },
    {
      "id": "unit.prewalk",
      "kind": "action",
      "trigger": { "phase": "prewalk", "kind": "unit" },
      "action": "run_prewalk",
      "stop": true
    },
    {
      "id": "unit.critic",
      "kind": "action",
      "trigger": { "phase": "critic", "kind": "unit" },
      "action": "run_critic",
      "stop": true
    },
    {
      "id": "spike.plan-pause",
      "kind": "picker",
      "trigger": { "phase": "plan-pause", "kind": "spike" },
      "prompt": "Execute spike tasks?",
      "default_option": 1,
      "options": [
        { "n": 1, "label": "Not now (default)" },
        { "n": 2, "label": "Execute spike tasks" }
      ]
    },
    {
      "id": "spike.blocked-override",
      "kind": "guard",
      "trigger": { "phase": "blocked", "kind": "spike" },
      "prompt": "Spike has unmet dependencies. Proceeding will override blocker checks.",
      "options": [
        { "n": 1, "label": "Stop (default)" },
        { "n": 2, "label": "Override and resume anyway" }
      ]
    }
  ]
}
