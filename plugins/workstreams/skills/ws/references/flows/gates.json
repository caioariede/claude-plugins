{
  "version": 1,
  "gates": [
    {
      "id": "unit.plan-pause",
      "kind": "action",
      "trigger": { "phase": "plan-pause", "kind": "unit" },
      "context_slots": ["plan_path", "task_titles"],
      "prompt": "Plan saved. Confirm to derive tasks and continue.",
      "action": "await_plan_confirm",
      "stop": true
    },
    {
      "id": "unit.blocked-override",
      "kind": "guard",
      "trigger": { "phase": "blocked", "kind": "unit" },
      "prompt": "Unit has unmet dependencies. Proceeding will override blocker checks.",
      "options": [
        { "n": 1, "label": "Stop (default)" },
        { "n": 2, "label": "Override and resume anyway" }
      ]
    },
    {
      "id": "unit.prewalk-config",
      "kind": "action",
      "trigger": { "phase": "prewalk-config", "kind": "unit" },
      "action": "print_required_config",
      "stop": true
    },
    {
      "id": "unit.prewalk",
      "kind": "action",
      "trigger": { "phase": "prewalk", "kind": "unit" },
      "action": "run_prewalk",
      "stop": true
    },
    {
      "id": "unit.critic",
      "kind": "action",
      "trigger": { "phase": "critic", "kind": "unit" },
      "action": "run_critic",
      "stop": true
    },
    {
      "id": "spike.plan-pause",
      "kind": "action",
      "trigger": { "phase": "plan-pause", "kind": "spike" },
      "context_slots": ["plan_path", "task_titles"],
      "prompt": "Plan saved. Confirm to derive tasks and continue.",
      "action": "await_plan_confirm",
      "stop": true
    },
    {
      "id": "spike.blocked-override",
      "kind": "guard",
      "trigger": { "phase": "blocked", "kind": "spike" },
      "prompt": "Spike has unmet dependencies. Proceeding will override blocker checks.",
      "options": [
        { "n": 1, "label": "Stop (default)" },
        { "n": 2, "label": "Override and resume anyway" }
      ]
    },
    {
      "id": "unit.done",
      "kind": "action",
      "trigger": { "phase": "done", "kind": "unit" },
      "context_slots": ["ws_id", "slug"],
      "prompt": "Target complete. Run ws-next to route — do not ws-start, provision, or implement another slug.",
      "action": "chain_ws_next",
      "stop": true
    },
    {
      "id": "spike.done",
      "kind": "action",
      "trigger": { "phase": "done", "kind": "spike" },
      "context_slots": ["ws_id", "slug"],
      "prompt": "Target complete. Run ws-next to route — do not ws-start, provision, or implement another slug.",
      "action": "chain_ws_next",
      "stop": true
    }
  ]
}
