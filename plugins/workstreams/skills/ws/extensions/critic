#!/usr/bin/env python3
"""Critic extension handler — post_scoped_work slot."""

from __future__ import annotations

import sys
from pathlib import Path
from typing import Any, Dict, List, Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _protocol import run_pending, unit_log  # noqa: E402


def _has_skipped(log: List[List[str]], reason: str) -> bool:
    needle = f"critic=skipped reason={reason}"
    return any(
        len(row) >= 3 and row[1] == "decision" and needle in row[2]
        for row in log
    )


def _has_done(log: List[List[str]], digest: str) -> bool:
    for row in reversed(log):
        if len(row) < 3 or row[1] != "decision":
            continue
        payload = row[2]
        if not payload.startswith("critic=done"):
            continue
        if f"digest={digest}" in payload:
            return True
    return False


def pending(ctx: Dict[str, Any]) -> Optional[str]:
    if "critic" in (ctx.get("skip") or []):
        return None
    digest = (ctx.get("artifacts") or {}).get("tree_digest")
    if not digest:
        return None
    log = unit_log(ctx)
    if _has_done(log, digest):
        return None
    if (_has_skipped(log, "headless")
            or _has_skipped(log, "grandfather")
            or _has_skipped(log, "flag")):
        return None
    return "critic"


if __name__ == "__main__":
    raise SystemExit(run_pending(pending))
