tool := justfile_directory() / "../../tools/plugin_version.py"
plugin := justfile_directory()
guide := justfile_directory() / "skills/ws-guide/assets/WORKSTREAMS-GUIDE"

# Regenerate the Workstreams guide PDF from its HTML source.
# The stamped version is major.minor, so patch releases need no
# regen. Bump first, then regenerate.
gen-guide-pdf:
    #!/usr/bin/env bash
    set -euo pipefail
    version=$(python3 "{{tool}}" series "{{plugin}}")
    stamp=$(date +"%B %Y")
    sed -i '' -E "s|<p class=\"version\">Version [^<]*</p>|<p class=\"version\">Version $version · $stamp</p>|" \
        "{{guide}}.html"
    chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    "$chrome" --headless --disable-gpu --no-pdf-header-footer \
        --print-to-pdf="{{guide}}.pdf" "file://{{guide}}.html"
    echo "wrote {{guide}}.pdf (version $version)"

# Fail when the guide's stamp disagrees with plugin.json's series.
check-guide:
    python3 "{{tool}}" check-guide "{{plugin}}" "{{guide}}.html"

# Apply the highest-severity skill bump to the plugin version and
# rewrite the snapshot. A no-op when no skill version moved. Run it
# once, last, before finalizing: interleaving skill edits with runs
# accumulates increments.
bump-plugin-version:
    python3 "{{tool}}" bump "{{plugin}}"

# Fail when plugin.json disagrees with what the snapshot plus the
# live skill versions imply.
check-plugin-version:
    python3 "{{tool}}" check "{{plugin}}"

# Force a plugin version into both plugin.json and the snapshot.
# The escape hatch for a deliberate promotion, such as 1.0.0.
set-plugin-version version:
    python3 "{{tool}}" set "{{plugin}}" "{{version}}"

# Every check CI runs.
check: check-plugin-version check-guide
    python3 -m unittest discover -s "{{justfile_directory()}}/../../tools/tests"
